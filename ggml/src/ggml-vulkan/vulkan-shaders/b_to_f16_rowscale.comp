#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// The f16 B operand of mul_mm_rdna4 / mul_mmv_rdna4: f32 rows to rows of K halves, then one f32 scale per
// row after them, one workgroup per row. A row with an element that would round to infinity as f16
// (|x| >= 65520) is converted as x * 2^-e, with the smallest e that keeps it finite, and gets the scale
// 2^e, by which the GEMM multiplies that output column; both products are exact. Every other row converts
// exactly as a plain f32 -> f16 copy and gets the scale 1.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (push_constant) uniform parameter {
    uint K;           // elements per row
    uint src_row;     // source row stride, in elements
    uint src_off;     // source misalignment, in elements
    uint scale_off;   // first scale, in floats from the start of the output
} p;

layout (binding = 0) readonly buffer A {float data_a[];};
layout (binding = 1) writeonly buffer D {float16_t data_d[];};
layout (binding = 1) writeonly buffer DS {float data_s[];};

// the smallest magnitude that rounds to infinity as f16
const float F16_OVERFLOW = 65520.0;

shared float smax[256];

void main() {
    const uint row = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationID.x;
    const uint a0  = p.src_off + row * p.src_row;
    const uint d0  = row * p.K;

    float amax = 0.0;
    for (uint k = tid; k < p.K; k += 256) {
        const float x = data_a[a0 + k];
        data_d[d0 + k] = float16_t(x);
        amax = max(amax, abs(x));
    }
    smax[tid] = amax;
    barrier();
    [[unroll]] for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) {
            smax[tid] = max(smax[tid], smax[tid + s]);
        }
        barrier();
    }
    amax = smax[0];

    float scale = 1.0;
    if (amax >= F16_OVERFLOW) {
        // e <= 126 keeps both powers of two normal; an infinite element stays infinite, as it would unscaled
        uint e = 0;
        for (float m = amax; m >= F16_OVERFLOW && e < 126; m *= 0.5) {
            e++;
        }
        const float down = uintBitsToFloat((127u - e) << 23);
        scale = uintBitsToFloat((127u + e) << 23);
        for (uint k = tid; k < p.K; k += 256) {
            data_d[d0 + k] = float16_t(data_a[a0 + k] * down);
        }
    }
    if (tid == 0) {
        data_s[p.scale_off + row] = scale;
    }
}
