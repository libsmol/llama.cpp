#version 450

// loop message controller: out = (1 - tanh(f))*a + tanh(g)*m
layout (local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly  buffer A {float data_a[];};
layout (binding = 1) readonly  buffer M {float data_m[];};
layout (binding = 2) readonly  buffer G {float data_g[];};
layout (binding = 3) readonly  buffer F {float data_f[];};
layout (binding = 4) writeonly buffer D {float data_d[];};

layout (push_constant) uniform parameter {
    uint ne0, ne1;
    uint nba1, nbm1, nbg1, nbf1;
    uint a_offset, m_offset, g_offset, f_offset, d_offset;
} p;

float tanh_safe(const float x) {
    return 1.0 - 2.0/(exp(2.0*x) + 1.0);
}

void main() {
    const uint i = gl_GlobalInvocationID.z*262144u + gl_GlobalInvocationID.y*512u + gl_GlobalInvocationID.x;
    if (i >= p.ne0*p.ne1) {
        return;
    }
    const uint i1 = i/p.ne0;
    const uint i0 = i - i1*p.ne0;

    const float a = data_a[p.a_offset + i1*p.nba1 + i0];
    const float m = data_m[p.m_offset + i1*p.nbm1 + i0];
    const float g = data_g[p.g_offset + i1*p.nbg1 + i0];
    const float f = data_f[p.f_offset + i1*p.nbf1 + i0];

    data_d[p.d_offset + i] = (1.0 - tanh_safe(f))*a + tanh_safe(g)*m;
}
