#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

// out[i, t] = (1 - tanh(wf[:, i] . h[:, t]))*a[i, t] + tanh(wg[:, i] . h[:, t])*m[i, t]
// one subgroup per output row: the lanes read the contiguous rank elements of wg[:, i] and wf[:, i]
layout (constant_id = 0) const uint BLOCK_SIZE = 256;
layout (local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly  buffer A  {float data_a[];};
layout (binding = 1) readonly  buffer M  {float data_m[];};
layout (binding = 2) readonly  buffer H  {float data_h[];};
layout (binding = 3) readonly  buffer WG {float data_wg[];};
layout (binding = 4) readonly  buffer WF {float data_wf[];};
layout (binding = 5) writeonly buffer D  {float data_d[];};

layout (push_constant) uniform parameter {
    uint n_embd, n_rank, n_t;
    uint nba1, nbm1, nbh1, nbw1;
    uint a_offset, m_offset, h_offset, wg_offset, wf_offset, d_offset;
} p;

float tanh_safe(const float x) {
    return 1.0 - 2.0/(exp(2.0*x) + 1.0);
}

void main() {
    const uint it   = gl_WorkGroupID.y;
    const uint lane = gl_SubgroupInvocationID;
    const uint rows_per_wg = BLOCK_SIZE/gl_SubgroupSize;
    const uint i    = gl_WorkGroupID.x*rows_per_wg + gl_SubgroupID;

    if (i >= p.n_embd) {
        return;
    }

    const uint gb = p.wg_offset + i*p.nbw1;
    const uint fb = p.wf_offset + i*p.nbw1;
    const uint hb = p.h_offset + it*p.nbh1;
    float g = 0.0, f = 0.0;
    for (uint r = lane; r < p.n_rank; r += gl_SubgroupSize) {
        const float hv = data_h[hb + r];
        g += data_wg[gb + r]*hv;
        f += data_wf[fb + r]*hv;
    }
    g = subgroupAdd(g);
    f = subgroupAdd(f);

    if (subgroupElect()) {
        const float av = data_a[p.a_offset + it*p.nba1 + i];
        const float mv = data_m[p.m_offset + it*p.nbm1 + i];
        data_d[p.d_offset + it*p.n_embd + i] = (1.0 - tanh_safe(f))*av + tanh_safe(g)*mv;
    }
}
