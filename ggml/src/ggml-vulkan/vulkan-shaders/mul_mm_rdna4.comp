// Prefill GEMM for RDNA4 (wave32 WMMA): D[n][m] = sum_k A[m][k] * B[n][k]
// A: Q3_K/Q4_K/Q5_K/Q6_K/IQ3_S/IQ4_XS/IQ4_NL/Q8_0, dequantized to f16 (round to nearest) into LDS, or BF16, converted to
// f16 (exact unless |w| < 2^-14, which becomes an f16 subnormal). B: f16. f32 accumulation.
// With flags bit 2, row n of B was stored times 1 / scale[n] to keep it finite as f16 (b_to_f16_rowscale.comp),
// and output column n is multiplied by scale[n].
//
// Warp-specialized: 8 consumer waves run the WMMAs on 64x64 slices of the 128x256 tile, 4 producer
// waves load and dequantize. LDS is double-buffered in 32-deep K stages, and the producers keep two
// more stages in flight in registers.

layout(local_size_x = 384, local_size_y = 1, local_size_z = 1) in;

// Workgroups [0, n_full) compute whole tiles. Each later tile (the partial last wave) is split along K
// over n_parts workgroups of k_part stages: part 0 writes D, the others write partial sums to S, which
// mul_mm_rdna4_reduce.comp adds into D.
layout (push_constant) uniform parameter {
    uint M; uint N; uint K;
    uint stride_a; uint stride_b; uint stride_d;
    uint flags;      // bit 0: D is 16-byte aligned (vec4 stores); bit 1: tiles numbered along N first;
                     // bit 2: B has a scale per row at bs_off
    uint tiles_m;
    uint n_full;
    uint n_parts;
    uint k_part;
    // epi 1 / 2: SwiGLU epilogue (one whole tile per workgroup). The accumulator is the up / gate half; the
    // other half is read as f32 from binding 3 (rows of o_stride at o_off), and h = silu(gate) * up is
    // written as f16 to binding 2 (rows of stride_d at h_off) instead of D. Offsets in elements.
    uint epi;
    uint o_stride;
    uint o_off;
    uint h_off;
    uint bs_off;     // the scales of B in binding 1, in floats
} p;

layout (binding = 0) readonly buffer A {uvec4 data_a[];};
layout (binding = 1) readonly buffer B {uvec4 data_b[];};
layout (binding = 1) readonly buffer BS {float data_bs[];};  // only if flags bit 2 is set
layout (binding = 2) writeonly buffer D {float data_d[];};
layout (binding = 2) writeonly buffer D4 {vec4 data_d4[];};  // only if flags bit 0 is set
layout (binding = 3) writeonly buffer S {vec4 data_s4[];};   // split-tile partial sums, [tile][part - 1][n][m]
layout (binding = 2) writeonly buffer H {f16vec4 data_h4[];}; // epi: the f16 SwiGLU output
layout (binding = 3) readonly buffer O {vec4 data_o4[];};     // epi: the other half of the SwiGLU

#if defined(DATA_A_Q4_K)
const uint QBLK16 = 9;    // 144-byte blocks, in uvec4
const uint QS_OFF = 1;    // qs starts at byte 16
#elif defined(DATA_A_Q5_K)
const uint QBLK16 = 11;   // 176-byte blocks
const uint QH_OFF = 1;    // qh at byte 16
const uint QS_OFF = 3;    // qs at byte 48
#elif defined(DATA_A_IQ4_XS)
layout (binding = 0) readonly buffer A2 {uvec2 data_a2[];};
const uint QBLK8 = 17;    // 136-byte blocks, in uvec2: d, scales_h, scales_l[4], qs[128]
#elif defined(DATA_A_Q6_K)
layout (binding = 0) readonly buffer A1 {uint data_a1[];};
const uint QBYTES = 210;  // ql[128], qh[64], scales[16], d: blocks are only 2-byte aligned
#elif defined(DATA_A_Q3_K)
layout (binding = 0) readonly buffer A1 {uint data_a1[];};
const uint QBYTES = 110;  // hmask[32], qs[64], scales[12], d: blocks are only 2-byte aligned
#elif defined(DATA_A_IQ3_S)
layout (binding = 0) readonly buffer A1 {uint data_a1[];};
const uint QBYTES = 110;  // d, qs[64], qh[8], signs[32], scales[4]: blocks are only 2-byte aligned
#elif defined(DATA_A_IQ4_NL)
layout (binding = 0) readonly buffer A1 {uint data_a1[];};
const uint QBYTES = 18;   // d, qs[16]: one 32-weight block per stage, only 2-byte aligned
const uint QWORDS = 5;    // dwords covering a block at either alignment
#elif defined(DATA_A_Q8_0)
layout (binding = 0) readonly buffer A1 {uint data_a1[];};
const uint QBYTES = 34;   // d, qs[32]: one 32-weight block per stage, only 2-byte aligned
const uint QWORDS = 9;
#elif defined(DATA_A_BF16)
// 32 weights per stage: 64 bytes, 4 uvec4 of data_a
#else
#error unsupported
#endif

const uint BM = 128;
const uint BN = 256;
const uint BK = 32;
const uint RS = 5;         // LDS row stride in uvec4 (32 halves + 8 padding)
const uint NCONS = 8;      // consumer waves

shared uvec4 Ash[2 * BM * RS];
shared uvec4 Bsh[2 * BN * RS];

// 6-bit scale and min of sub-block j (ggml get_scale_min_k4) from the 12 scale bytes
void scale_min(const uvec3 sc, const uint j, out uint d, out uint m) {
    const uint b0  = (sc[j / 4] >> (8 * (j % 4))) & 0xFF;
    const uint b4  = (sc[(j + 4) / 4] >> (8 * ((j + 4) % 4))) & 0xFF;
    if (j < 4) {
        d = b0 & 63;
        m = b4 & 63;
    } else {
        const uint bm4 = (sc[(j - 4) / 4] >> (8 * ((j - 4) % 4))) & 0xFF;
        d = (b4 & 0xF) | ((bm4 >> 6) << 4);
        m = (b4 >> 4)  | ((b0 >> 6) << 4);
    }
}

// the scale of output column n: 1 unless row n of B would have overflowed f16
float b_scale(const uint n) {
    return ((p.flags & 4) != 0 && n < p.N) ? data_bs[p.bs_off + n] : 1.0f;
}
// (a select, so that a column with the scale 1 is stored exactly as computed)
vec4 b_scaled(const vec4 v, const float sc) {
    return sc == 1.0f ? v : v * sc;
}

// two f32 weights to packed f16, rounded to nearest (packHalf2x16 may round toward zero)
uint pk16(const vec2 v) {
    return packFloat2x16(f16vec2(v));
}

