    // hmask, the half of qs and scales + d are shifted into place when storing.
    const uint a_row_byte = am * (p.stride_a / 256) * QBYTES;
    uint r_hm[2][9], r_q3[2][9], r_sc[2][5], r_base[2];
    #define PIN_A(set) [[unroll]] for (uint i = 0; i < 9; ++i) { pin.x ^= r_hm[set][i] ^ r_q3[set][i]; } \
                       [[unroll]] for (uint i = 0; i < 5; ++i) { pin.y ^= r_sc[set][i]; } pin.z ^= r_base[set];
    #define FETCH(st, set) { \
