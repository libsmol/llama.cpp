    // ---- consumer state
    const uint wm = wave % 2;     // 64-row slice
    const uint wn = wave / 2;     // 64-column slice
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[4][4];
    [[unroll]] for (uint i = 0; i < 4; ++i) {
        [[unroll]] for (uint j = 0; j < 4; ++j) {
