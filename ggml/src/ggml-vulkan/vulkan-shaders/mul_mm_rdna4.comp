        return;
    }
    if (p.epi != 0) {
        // same expression and f16 rounding as swiglu_to_f16.comp
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            const uint n = n0 + wn * 64 + j * 16 + lane % 16;
            if (n >= p.N) {
                continue;
            }
            const float sc = b_scale(n);
            [[unroll]] for (uint i = 0; i < 4; ++i) {
                const uint m = m0 + wm * 64 + i * 16 + half_ * 8;
                if (m + 8 <= p.M) {
                    const uint oi = (p.o_off + n * p.o_stride + m) / 4;
                    const vec4 o0 = data_o4[oi], o1 = data_o4[oi + 1];
                    const vec4 a0 = b_scaled(vec4(acc[i][j][0], acc[i][j][1], acc[i][j][2], acc[i][j][3]), sc);
                    const vec4 a1 = b_scaled(vec4(acc[i][j][4], acc[i][j][5], acc[i][j][6], acc[i][j][7]), sc);
                    const vec4 g0 = p.epi == 1 ? o0 : a0, g1 = p.epi == 1 ? o1 : a1;
                    const vec4 u0 = p.epi == 1 ? a0 : o0, u1 = p.epi == 1 ? a1 : o1;
