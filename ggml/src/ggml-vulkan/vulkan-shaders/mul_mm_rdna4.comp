        return;
    }

    // ---- store: acc[i][j] element e of lane l is D[n0 + wn*64 + j*16 + l%16][m0 + wm*64 + i*16 + (l/16)*8 + e]
    const uint half_ = lane / 16;
    if (part > 0) {
        // partial sum of a split tile: the whole tile, [n][m] within the tile
        const uint sbase = ((tile - p.n_full) * (p.n_parts - 1) + part - 1) * (BM * BN / 4);
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            const float sc = b_scale(n0 + wn * 64 + j * 16 + lane % 16);
            [[unroll]] for (uint i = 0; i < 4; ++i) {
                const uint si = sbase + ((wn * 64 + j * 16 + lane % 16) * BM + wm * 64 + i * 16 + half_ * 8) / 4;
                data_s4[si]     = b_scaled(vec4(acc[i][j][0], acc[i][j][1], acc[i][j][2], acc[i][j][3]), sc);
                data_s4[si + 1] = b_scaled(vec4(acc[i][j][4], acc[i][j][5], acc[i][j][6], acc[i][j][7]), sc);
