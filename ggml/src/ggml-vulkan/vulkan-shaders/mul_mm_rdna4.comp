void main() {
    const uint wave = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const bool consumer = wave < NCONS;

    // this workgroup's tile and k stages [st0, st0 + nstages)
    const uint w    = gl_WorkGroupID.x;
    const bool split = w >= p.n_full;
    const uint tile = split ? p.n_full + (w - p.n_full) / p.n_parts : w;
    const uint part = split ? (w - p.n_full) % p.n_parts : 0;
    const uint tiles_n = (p.N + BN - 1) / BN;
    const bool n_fast = (p.flags & 2) != 0;
    const uint m0 = (n_fast ? tile / tiles_n : tile % p.tiles_m) * BM;
    const uint n0 = (n_fast ? tile % tiles_n : tile / p.tiles_m) * BN;
    const uint st0 = part * p.k_part;
    const uint nstages = split ? min(p.k_part, p.K / BK - st0) : p.K / BK;

    // ---- producer state: thread pt owns A row pt (one 32-weight sub-block per stage) and B rows
    //      2*pt and 2*pt+1
    const uint pt = gl_LocalInvocationIndex - NCONS * 32;
    const uint am = min(m0 + pt, p.M - 1);
    const uint b_row_base = (n0 + 2 * pt) * (p.stride_b / 8);
    const uint b_row_step = p.stride_b / 8;
    uvec4 r_b[2][8];

    #define FETCH_B(st, set) \
        [[unroll]] for (uint c = 0; c < 4; ++c) { \
            r_b[set][c]     = data_b[b_row_base + (st) * BK / 8 + c]; \
            r_b[set][4 + c] = data_b[b_row_base + b_row_step + (st) * BK / 8 + c]; \
        }
    #define STORE_B(set, buf) \
        [[unroll]] for (uint c = 0; c < 4; ++c) { \
            Bsh[(buf) * BN * RS + (2 * pt) * RS + c]     = r_b[set][c]; \
            Bsh[(buf) * BN * RS + (2 * pt + 1) * RS + c] = r_b[set][4 + c]; \
        }
    // FETCH results are unused until the next iteration, so the compiler sinks the loads past the
    // barriers to the loop latch, serializing them with their STORE. A use under a branch that is
    // never taken (n_parts is small) keeps them where they are issued.
    #define PIN_B(set) uvec4 pin = r_b[set][0]; [[unroll]] for (uint i = 1; i < 8; ++i) { pin ^= r_b[set][i]; }
    #define PIN(set) if (p.n_parts == 0xFFFFFFFFu) { PIN_B(set) PIN_A(set) Bsh[0] = pin; }

    // dequantized row pt of the stage: 32 halves in outw[16] -> Ash
    #define STORE_A(buf) \
        [[unroll]] for (uint c = 0; c < 4; ++c) { \
            Ash[(buf) * BM * RS + pt * RS + c] = uvec4(outw[4 * c], outw[4 * c + 1], outw[4 * c + 2], outw[4 * c + 3]); \
        }

#if defined(DATA_A_BF16)
    const uint a_row_base = am * (p.stride_a / 8);
    uvec4 r_a[2][4];
    #define PIN_A(set) [[unroll]] for (uint i = 0; i < 4; ++i) { pin ^= r_a[set][i]; }
    #define FETCH(st, set) { \
        [[unroll]] for (uint c = 0; c < 4; ++c) { \
            r_a[set][c] = data_a[a_row_base + (st) * BK / 8 + c]; \
        } \
        FETCH_B(st, set) \
    }
    // a bf16 pair is two f32 with their low 16 bits cleared, then rounded to f16
    #define STORE(st, set, buf) { \
        uint outw[16]; \
        [[unroll]] for (uint c = 0; c < 4; ++c) { \
            [[unroll]] for (uint e = 0; e < 4; ++e) { \
                const uint w = r_a[set][c][e]; \
                outw[c * 4 + e] = pk16(vec2(uintBitsToFloat(w << 16), uintBitsToFloat(w & 0xFFFF0000u))); \
            } \
        } \
        STORE_A(buf) \
        STORE_B(set, buf) \
    }
#elif defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
    const uint a_row_base = am * (p.stride_a / 256) * QBLK16;
    uvec4 r_hdr[2], r_qs[2][2];
#if defined(DATA_A_Q5_K)
    uvec4 r_qh[2][2];
    #define FETCH_QH(set) r_qh[set][0] = data_a[blk + QH_OFF]; r_qh[set][1] = data_a[blk + QH_OFF + 1];
    #define PIN_QH(set) ^ r_qh[set][0] ^ r_qh[set][1]
    #define DEQ_QH(set, h, c) v |= ((r_qh[set][h][c] >> sub) & 0x01010101) << 4;
#else
    #define FETCH_QH(set)
    #define PIN_QH(set)
    #define DEQ_QH(set, h, c)
#endif
    #define PIN_A(set) pin ^= r_hdr[set] ^ r_qs[set][0] ^ r_qs[set][1] PIN_QH(set);
    #define FETCH(st, set) { \
        const uint ks  = (st) * BK; \
        const uint blk = a_row_base + (ks / 256) * QBLK16; \
        const uint sub = (ks % 256) / 32; \
        r_hdr[set]   = data_a[blk]; \
        r_qs[set][0] = data_a[blk + QS_OFF + (sub / 2) * 2]; \
        r_qs[set][1] = data_a[blk + QS_OFF + (sub / 2) * 2 + 1]; \
        FETCH_QH(set) \
        FETCH_B(st, set) \
    }
    #define STORE(st, set, buf) { \
        const uint sub = (((st) * BK) % 256) / 32; \
        const vec2 dm = unpackHalf2x16(r_hdr[set].x); \
        uint sci, mni; \
        scale_min(r_hdr[set].yzw, sub, sci, mni); \
