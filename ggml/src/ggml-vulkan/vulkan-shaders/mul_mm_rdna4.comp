    // The two roles run separate loops with the same number of barriers (the role is wave-uniform),
    // so the producers' in-flight registers never count against the consumers' accumulators.
    // Barrier t (t = 0 .. nstages): stage t is in LDS buffer t & 1, stage t - 1 is consumed.
    if (consumer) {
        barrier();
        [[dont_unroll]]
        for (uint s = 0; s < nstages; ++s) {
            const uint buf = s & 1;
            [[unroll]] for (uint kk = 0; kk < BK; kk += 16) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> af[4];
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> bf[4];
