                    // zero keeps ACO from fusing both into one v_fma_mix that rounds only once
                    const uvec4 z  = uvec4(p.epi >> 16);
                    const vec4  r0 = uintBitsToFloat(floatBitsToUint(g0 / (1.0f + exp(-g0)) * u0) | z);
