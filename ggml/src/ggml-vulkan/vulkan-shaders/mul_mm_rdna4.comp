        // past the end reload the last stage (unconditional, so the load counters stay exact).
        const uint last = st0 + nstages - 1;
        FETCH(st0, 0);
        FETCH(min(st0 + 1, last), 1);
        STORE(st0, 0, 0);
        FETCH(min(st0 + 2, last), 0);
        barrier();
        [[dont_unroll]]
        for (uint s = 0; s < nstages; s += 2) {
            if (s + 1 < nstages) {
                STORE(st0 + s + 1, 1, 1);
            }
            FETCH(min(st0 + s + 3, last), 1);
            PIN(1)
            barrier();
            if (s + 1 < nstages) {
                if (s + 2 < nstages) {
                    STORE(st0 + s + 2, 0, 0);
                }
                FETCH(min(st0 + s + 4, last), 0);
                PIN(0)
                barrier();
            }
