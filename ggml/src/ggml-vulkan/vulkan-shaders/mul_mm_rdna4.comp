        return;
    }
    const bool d_vec4 = (p.flags & 1) != 0 && (p.stride_d % 4) == 0;
    [[unroll]] for (uint j = 0; j < 4; ++j) {
        const uint n = n0 + wn * 64 + j * 16 + lane % 16;
        if (n >= p.N) {
            continue;
        }
        const float sc = b_scale(n);
        [[unroll]] for (uint i = 0; i < 4; ++i) {
            const uint m = m0 + wm * 64 + i * 16 + half_ * 8;
            if (m + 8 <= p.M) {
                const uint di = n * p.stride_d + m;
                const vec4 v0 = b_scaled(vec4(acc[i][j][0], acc[i][j][1], acc[i][j][2], acc[i][j][3]), sc);
                const vec4 v1 = b_scaled(vec4(acc[i][j][4], acc[i][j][5], acc[i][j][6], acc[i][j][7]), sc);
                if (d_vec4) {
                    data_d4[di / 4]     = v0;
                    data_d4[di / 4 + 1] = v1;
                } else {
                    [[unroll]] for (uint e = 0; e < 4; ++e) {
                        data_d[di + e]     = v0[e];
                        data_d[di + 4 + e] = v1[e];
                    }
                }
            }
        }
    }
}
