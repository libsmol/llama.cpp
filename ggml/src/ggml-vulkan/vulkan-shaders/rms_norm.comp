#version 450

#include "generic_binary_head.glsl"
#include "types.glsl"

#extension GL_EXT_control_flow_attributes : enable
#if USE_SUBGROUP_ADD
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif

layout (constant_id = 3) const int BLOCK_SIZE = 512;
// false: loop with a runtime count instead of instantiating rms_norm() for fixed counts
layout (constant_id = 4) const bool UNROLL = true;
layout(local_size_x_id = 3, local_size_y = 1, local_size_z = 1) in;

#if RMS_NORM_ROPE_FUSION

layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
layout (binding = 1) readonly buffer B {B_TYPE data_b[];};

// data is passed from rms_norm -> rope through shared memory.
// rms_norm calls this data_d, rope calls this rope_data_a.
// Binding 2 is not used
// host picks a block size such that ncols <= 2*BLOCK_SIZE
shared FLOAT_TYPE rope_data_a[2*BLOCK_SIZE];
#define data_d rope_data_a

layout (binding = 3) readonly buffer R_Y {int rope_data_pos[];};
layout (binding = 4) readonly buffer R_Z {float rope_data_ff[];};
layout (binding = 5) writeonly buffer R_D {ROPE_D_TYPE rope_data_d[];};
layout (binding = 6) readonly buffer R_I {uvec2 rope_data_i[];}; // indices for set_rows

#include "rope_params.glsl"
#include "rope_funcs.glsl"

#define GGML_ROPE_TYPE_NORMAL 0
#define GGML_ROPE_TYPE_NEOX   2
#define GGML_ROPE_TYPE_MROPE  8
#define GGML_ROPE_TYPE_VISION 24

#elif RMS_NORM_ADD_FUSION

layout (binding = 3) readonly buffer C {C_TYPE data_c[];};
layout (binding = 4) readonly buffer E {float data_e[];};

#elif RMS_NORM_SET_ROWS_FUSION

layout (binding = 3) readonly buffer I {uvec2 data_i[];};

#endif

#if RMS_NORM_F16_OUT
// RMS_NORM + MUL that also writes its result as the f16 B operand of the consuming mul_mmv_rdna4 into binding 4,
// in the layout of b_to_f16_rowscale.comp for rows_alloc = the rows of this dispatch: rows of ncols halves, then
// one f32 scale per row. Same values: each f16 is converted from the f32 result as stored, and a row that would
// overflow f16 is stored times 2^-e with the scale 2^e, e as b_to_f16_rowscale.comp chooses it.
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout (binding = 4) writeonly buffer H {float16_t data_h[];};
layout (binding = 4) writeonly buffer HS {float data_hs[];};
// the smallest magnitude that rounds to infinity as f16
const float F16_OVERFLOW = 65520.0;
// the largest row maximum >= F16_OVERFLOW (as bits, which order non-negative floats), else 0
shared uint amax_bits;
#endif

layout (constant_id = 1) const bool do_multiply = false;
#if RMS_NORM_ADD_FUSION
layout (constant_id = 2) const bool do_post_multiply = false;
#endif

shared FLOAT_TYPE sumsh[BLOCK_SIZE];

void rms_norm(uint num_iters) {
    const uint ncols     = p.ne00;
    const uint nrows     = gl_NumWorkGroups.x;
    const uint nchannels = p.ne02;
    const uint nsamples  = p.ne03;

    const uint row       = gl_WorkGroupID.x;
    const uint tid       = gl_LocalInvocationID.x;

    const uint stride_row       = p.nb01;
    const uint stride_channel   = p.nb02;
    const uint stride_sample    = p.nb03;

    // grid.y/z are clamped to the device workgroup limit, iterate over the excess channels/samples
    for (uint samp = gl_WorkGroupID.z; samp < nsamples; samp += gl_NumWorkGroups.z) {
        for (uint channel = gl_WorkGroupID.y; channel < nchannels; channel += gl_NumWorkGroups.y) {
            barrier();
#if RMS_NORM_F16_OUT
            // ordered before the atomics below by the barriers of the reduction
            if (tid == 0) {
                amax_bits = 0;
            }
            // a runtime zero (param3 is the partials count, 0 here): OR-ing it in keeps the f32 result rounded
            // before the f16 conversion, which the compiler could otherwise fuse with the last multiply
            const uint f16_zero = uint(p.param3) & 0x80000000u;
            float amax = 0.0;
#endif

            uint32_t a_offset = samp*stride_sample + channel*stride_channel + row*stride_row + get_aoffset();
            uint32_t b_offset = src1_idx(0, row, channel, samp) + get_boffset();
#if RMS_NORM_ROPE_FUSION
            // Per-row offset in shared memory
            uint32_t d_offset = 0;
#elif RMS_NORM_SET_ROWS_FUSION
            uint32_t d_offset = data_i[channel].x*p.nb21 + row*ncols + get_doffset();
#else
            uint32_t d_offset = ((samp*nchannels + channel)*nrows + row)*ncols + get_doffset();
#endif
            FLOAT_TYPE sum = FLOAT_TYPE(0.0f); // partial sum for thread in warp

#if RMS_NORM_ROPE_FUSION
            for (uint col = tid; col < ncols; col += BLOCK_SIZE) {
                const FLOAT_TYPE xi = FLOAT_TYPE(data_a[a_offset + col]);
                sum += xi * xi;
            }
#else
            [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
                FLOAT_TYPE xi = FLOAT_TYPE(0);
                if (col < ncols) {
                    xi = FLOAT_TYPE(A_TO_FLOAT(data_a[a_offset + col]));
                }
                sum += xi * xi;
            }
#endif

            #if USE_SUBGROUP_ADD
                sum = subgroupAdd(sum);
                if (subgroupElect()) {
                    sumsh[gl_SubgroupID] = sum;
                }
                barrier();
                sum = FLOAT_TYPE(0.0f);
                if(gl_NumSubgroups <= 4) { // fast path to skip the 2nd subgroupAdd
                    [[unroll]] for(uint i=0; i < gl_NumSubgroups; ++i) {
                        sum += sumsh[i];
                    }
                }
                else {
                    // Each subgroup reads the partials, so one workgroup barrier is enough.
                    for (uint i = gl_SubgroupInvocationID; i < gl_NumSubgroups; i += gl_SubgroupSize) {
                        sum += sumsh[i];
                    }
                    sum = subgroupAdd(sum);
                }
            #else
                sumsh[tid] = sum;
                // sum up partial sums and write back result
                barrier();
                [[unroll]] for (int s = BLOCK_SIZE / 2; s > 0; s >>= 1) {
                    if (tid < s) {
                        sum += sumsh[tid + s];
                        sumsh[tid] = sum;
                    }
                    barrier();
                }
                sum = sumsh[0];
            #endif

            const FLOAT_TYPE mean = sum / FLOAT_TYPE(ncols);
            const FLOAT_TYPE scale = inversesqrt(mean + FLOAT_TYPE(p.param1));

#if RMS_NORM_ROPE_FUSION
            for (uint col = tid; col < ncols; col += BLOCK_SIZE) {
                FLOAT_TYPE value = scale * FLOAT_TYPE(data_a[a_offset + col]);
                if (do_multiply) {
                    value *= FLOAT_TYPE(data_b[b_offset + fastmod(col, p.ne10)]);
                }
                data_d[d_offset + col] = D_TYPE(value);
            }
#else
            if (do_multiply) {
                if (ncols > p.ne10) {
                    [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
                        if (col >= ncols) {
                            continue;
                        }
                        FLOAT_TYPE value = scale * FLOAT_TYPE(A_TO_FLOAT(data_a[a_offset + col])) * FLOAT_TYPE(B_TO_FLOAT(data_b[b_offset + fastmod(col, p.ne10)]));
#if RMS_NORM_ADD_FUSION
                        value += FLOAT_TYPE(C_TO_FLOAT(data_c[d_offset + col]));
                        if (do_post_multiply) {
                            value *= FLOAT_TYPE(data_e[0]);
                        }
#endif
                        data_d[d_offset + col] = FLOAT_TO_D(value);
                    }
                } else {
                    [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
                        if (col >= ncols) {
                            continue;
                        }
                        FLOAT_TYPE value = scale * FLOAT_TYPE(A_TO_FLOAT(data_a[a_offset + col])) * FLOAT_TYPE(B_TO_FLOAT(data_b[b_offset + col]));
#if RMS_NORM_ADD_FUSION
                        value += FLOAT_TYPE(C_TO_FLOAT(data_c[d_offset + col]));
                        if (do_post_multiply) {
                            value *= FLOAT_TYPE(data_e[0]);
                        }
#endif
                        data_d[d_offset + col] = FLOAT_TO_D(value);
#if RMS_NORM_F16_OUT
                        const float hv = uintBitsToFloat(floatBitsToUint(float(value)) | f16_zero);
                        data_h[row * ncols + col] = float16_t(hv);
                        amax = max(amax, abs(hv));
#endif
                    }
                }
#if RMS_NORM_F16_OUT
                if (amax >= F16_OVERFLOW) {
                    atomicMax(amax_bits, floatBitsToUint(amax));
                }
                barrier();
                const float gmax = uintBitsToFloat(amax_bits);
                float hscale = 1.0;
                if (gmax >= F16_OVERFLOW) {
                    // e <= 126 keeps both powers of two normal; an infinite element stays infinite, as it would unscaled
                    uint e = 0;
                    for (float m = gmax; m >= F16_OVERFLOW && e < 126; m *= 0.5) {
                        e++;
                    }
                    const float down = uintBitsToFloat((127u - e) << 23);
                    hscale = uintBitsToFloat((127u + e) << 23);
                    [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
                        if (col >= ncols) {
                            continue;
                        }
                        const FLOAT_TYPE value = scale * FLOAT_TYPE(data_a[a_offset + col]) * FLOAT_TYPE(data_b[b_offset + col]);
                        const float hv = uintBitsToFloat(floatBitsToUint(float(value)) | f16_zero);
                        data_h[row * ncols + col] = float16_t(hv * down);
                    }
                }
                if (tid == 0) {
                    // rows_alloc = rows: the scales follow the rows * ncols halves, at a 16-byte boundary
                    data_hs[(((nrows * ncols * 2) + 15) & ~15u) / 4 + row] = hscale;
                }
#endif
            } else {
                [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
                    if (col >= ncols) {
                        continue;
                    }
                    data_d[d_offset + col] = FLOAT_TO_D(scale * FLOAT_TYPE(A_TO_FLOAT(data_a[a_offset + col])));
                }
            }
#endif
#if RMS_NORM_ROPE_FUSION
            barrier();
            rope_params rp = p.rope;
            for (uint t = 2*tid; t < ncols; t += 2*BLOCK_SIZE) {
                if (rp.rope_mode == GGML_ROPE_TYPE_NEOX) {
                    rope_neox(t, row, channel, samp, rp);
                } else if (rp.rope_mode == GGML_ROPE_TYPE_NORMAL) {
                    rope_norm(t, row, channel, samp, rp);
                }
            }
#endif
        }
    }
}

void main() {
#if RMS_NORM_ROPE_FUSION
    const uint num_blocks = (p.ne00 + BLOCK_SIZE - 1) / BLOCK_SIZE;
    rms_norm(num_blocks);
#else
    // instantiate the rms_norm function for several different
    // dimensions, to allow loop unrolling
    uint num_blocks = (p.ne00 + BLOCK_SIZE - 1) / BLOCK_SIZE;
    if (!UNROLL || num_blocks > 32) {
        rms_norm(num_blocks);
    } else if (num_blocks > 16) {
        rms_norm(32);
    } else if (num_blocks > 12) {
        rms_norm(16);
    } else if (num_blocks > 10) {
        rms_norm(12);
    } else if (num_blocks > 8) {
        rms_norm(10);
    } else if (num_blocks > 4) {
        rms_norm(8);
    } else if (num_blocks == 4) {
        rms_norm(4);
    } else if (num_blocks == 3) {
        rms_norm(3);
    } else if (num_blocks == 2) {
        rms_norm(2);
    } else if (num_blocks == 1) {
        rms_norm(1);
    }
#endif
}
