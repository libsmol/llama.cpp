#version 450

#include "glu_head.glsl"

#include "tanh_safe.glsl"

// situ(g, u) = beta*tanh(g/beta)*sigmoid(g) * lb*tanh(u/lb); alpha = beta, limit = lb (lb <= 0: identity on u)
float op(float a, float b) {
    const float gate = p.alpha * tanh_safe(a / p.alpha) / (1.0f + exp(-a));
    const float up   = p.limit > 0.0f ? p.limit * tanh_safe(b / p.limit) : b;

    return gate * up;
}

#include "glu_main.glsl"
